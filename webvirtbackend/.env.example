# Copy to .env before running docker compose in this directory.
WEBVIRT_DEV_DB_PASSWORD=change-me-generate-with-openssl-rand-hex-24
WEBVIRT_DEV_DB_ROOT_PASSWORD=change-me-generate-with-openssl-rand-hex-24
WEBVIRT_DEV_RABBITMQ_PASSWORD=change-me-generate-with-openssl-rand-hex-24
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT_MAPPING_FILE=/etc/vm_port_mapping/mapping.txt
PORT_MAPPING_PUBLIC_IP=
PORT_MAPPING_PUBLIC_IP_TIMEOUT=5
