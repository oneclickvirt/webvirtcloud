# Copy to env.local or run ./webvirtcloud.sh env/start to generate secure values.
# Use a DNS name for public deployment, or a LAN IP such as 192.168.1.10 for intranet-only deployment.
DOMAIN_NAME=webvirtcloud.example.com
DJANGO_SECRET_KEY=change-me-generate-with-openssl-rand-hex-48
DJANGO_ALLOWED_HOSTS=webvirtcloud.example.com,localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://webvirtcloud.example.com,http://webvirtcloud.example.com

MARIADB_PASSWORD=change-me-generate-with-openssl-rand-hex-24
MARIADB_ROOT_PASSWORD=change-me-generate-with-openssl-rand-hex-24
DB_PASSWORD=change-me-same-as-MARIADB_PASSWORD

RABBITMQ_DEFAULT_PASS=change-me-generate-with-openssl-rand-hex-24
CELERY_BROKER_URL=amqp://django:change-me-generate-with-openssl-rand-hex-24@rabbitmq:5672//webvirtcloud

WEBVIRT_ADMIN_EMAIL=admin@example.com
WEBVIRT_ADMIN_PASSWORD=change-me-generate-with-openssl-rand-hex-18

PORT_MAPPING_FILE=/etc/vm_port_mapping/mapping.txt
PORT_MAPPING_PUBLIC_IP=
PORT_MAPPING_PUBLIC_IP_TIMEOUT=5

VITE_API_PREFIX=/api/v1
VITE_BASE=/static/
VITE_DISPLAY_PRICES=true
VITE_LOADBALANCER=true
