# Domain environment variables
DOMAIN_NAME=webvirtcloud.app

# VITE environment variables
VITE_BASE=/static/
VITE_API_PREFIX=/api/v1

# MariaDB environment variables
MARIADB_USER=django
MARIADB_PASSWORD=
MARIADB_DATABASE=webvirtcloud
MARIADB_ROOT_PASSWORD=
MARIADB_MYSQL_LOCALHOST_USER=1
MARIADB_MYSQL_LOCALHOST_GRANTS=USAGE

# RabbitMQ environment variables
RABBITMQ_DEFAULT_USER=django
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=/webvirtcloud

# DB connection environment variables
DB_HOST=mariadb
DB_NAME=webvirtcloud
DB_USER=django
DB_PASSWORD=

# Email environment variables
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_FROM="WebVirtCloud <noreply@gmail.com>"

# Python environment variables
PYTHONOPTIMIZE=1

# Ansible environment variables
ANSIBLE_HOST_KEY_CHECKING=0
ANSIBLE_PARAMIKO_LOOK_FOR_KEYS=0

# Django environment variables
DJANGO_SETTINGS_MODULE=webvirtcloud.settings.production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=webvirtcloud.app,localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://webvirtcloud.app,http://webvirtcloud.app

# Optional port mapping sync settings
PORT_MAPPING_FILE=/etc/vm_port_mapping/mapping.txt
PORT_MAPPING_PUBLIC_IP=
PORT_MAPPING_PUBLIC_IP_TIMEOUT=5

# Celery environment variables
CELERY_BROKER_URL=
